# Copy this file to `.dev.vars` and fill in real values.
# Wrangler loads `.dev.vars` automatically when running `npm run dev`.
# `.dev.vars` is gitignored — `.dev.vars.example` is the committed template.

# Your Auth0 tenant domain (e.g. dev-abc123.us.auth0.com)
AUTH0_DOMAIN=

# Client ID from your Auth0 "Regular Web Application"
AUTH0_CLIENT_ID=

# Client Secret from your Auth0 "Regular Web Application"
AUTH0_CLIENT_SECRET=

# Public base URL of this app — http://localhost:8787 for local dev
APP_BASE_URL=http://localhost:8787

# Random string, at least 32 characters. Generate with:
#   openssl rand -hex 32
AUTH0_SESSION_ENCRYPTION_KEY=

# Identifier of the Auth0 API Resource Server (set by `npm run setup`).
# This causes Auth0 to issue a JWT access token and embed `permissions` when RBAC is enabled.
AUTH0_AUDIENCE=
